{
  "name": "unplugin-tdesign-icons",
  "version": "0.1.0",
  "description": "An unplugin for on-demand importing TDesign icons (vue-next & react). Auto rewrites `import { XxxIcon } from 'tdesign-icons-xxx'` to the exact icon module, avoiding bundling all 2000+ icons.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./vue": {
      "import": {
        "types": "./dist/vue.d.ts",
        "default": "./dist/vue.js"
      },
      "require": {
        "types": "./dist/vue.d.cts",
        "default": "./dist/vue.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./vite": "./dist/vite.js",
    "./rollup": "./dist/rollup.js",
    "./webpack": "./dist/webpack.js",
    "./esbuild": "./dist/esbuild.js",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "keywords": [
    "unplugin",
    "tdesign",
    "tdesign-icons",
    "icons",
    "vite",
    "webpack",
    "rollup",
    "vue",
    "react"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "tdesign-icons-react": ">=0.6.0",
    "tdesign-icons-vue-next": ">=0.4.0",
    "vite": "^4 || ^5 || ^6 || ^7"
  },
  "peerDependenciesMeta": {
    "tdesign-icons-react": {
      "optional": true
    },
    "tdesign-icons-vue-next": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "es-module-lexer": "^2.3.1",
    "magic-string": "^1.1.0",
    "unplugin": "^3.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "rollup": "^4.30.0",
    "tdesign-icons-react": "^0.6.9",
    "tdesign-icons-vue-next": "^0.4.9",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  }
}
