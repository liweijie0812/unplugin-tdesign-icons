{
  "name": "unplugin-tdesign-icons",
  "version": "0.1.0",
  "description": "An unplugin for on-demand importing TDesign icons (vue / vue-next / react / web-components). Auto rewrites `import { XxxIcon } from 'tdesign-icons-xxx'` to the exact icon module, avoiding bundling all 2000+ icons.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./TDesignIconsVue": "./dist/TDesignIconsVue.js",
    "./vue": "./dist/TDesignIconsVue.js",
    "./TDesignIconsVueNext": "./dist/TDesignIconsVueNext.js",
    "./vue-next": "./dist/TDesignIconsVueNext.js",
    "./TDesignIconsReact": "./dist/TDesignIconsReact.js",
    "./react": "./dist/TDesignIconsReact.js",
    "./TDesignIconsWebComponents": "./dist/TDesignIconsWebComponents.js",
    "./web-components": "./dist/TDesignIconsWebComponents.js",
    "./vite": "./dist/vite.js",
    "./rollup": "./dist/rollup.js",
    "./rolldown": "./dist/rolldown.js",
    "./webpack": "./dist/webpack.js",
    "./rspack": "./dist/rspack.js",
    "./esbuild": "./dist/esbuild.js",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "keywords": [
    "unplugin",
    "tdesign",
    "tdesign-icons",
    "icons",
    "vite",
    "webpack",
    "rollup",
    "vue",
    "react",
    "web-components"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "tdesign-icons-react": ">=0.6.0",
    "tdesign-icons-vue": ">=0.4.0",
    "tdesign-icons-vue-next": ">=0.4.0",
    "tdesign-icons-web-components": ">=0.3.0",
    "vite": "^4 || ^5 || ^6 || ^7"
  },
  "peerDependenciesMeta": {
    "tdesign-icons-react": {
      "optional": true
    },
    "tdesign-icons-vue": {
      "optional": true
    },
    "tdesign-icons-vue-next": {
      "optional": true
    },
    "tdesign-icons-web-components": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "es-module-lexer": "^2.3.1",
    "magic-string": "^1.1.0",
    "unplugin": "^3.3.0"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rspack/core": "^2.1.8",
    "@types/node": "^22.10.2",
    "esbuild": "^0.28.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rolldown": "^1.2.3",
    "rollup": "^4.30.0",
    "tdesign-icons-react": "^0.6.9",
    "tdesign-icons-vue": "^0.4.9",
    "tdesign-icons-vue-next": "^0.4.9",
    "tdesign-icons-web-components": "^0.3.7",
    "ts-loader": "^9.6.2",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.0",
    "vitest": "^2.1.8",
    "webpack": "^5.109.2"
  }
}
